#!/usr/bin/env bash
# Omni Workflow State CLI
# Usage: omni-wf-state [get|init|phase <PHASE>|stage <STAGE>]

set -euo pipefail

OMNI_DIR=".omni-wf"
STATE_FILE="$OMNI_DIR/state.md"

cmd="${1:-get}"

ensure_dirs() {
  mkdir -p "$OMNI_DIR" "docs/prds" "docs/decisions" "docs/adr" "docs/specs"
}

case "$cmd" in
  get)
    if [ -f "$STATE_FILE" ]; then
      cat "$STATE_FILE"
    else
      echo "No state found. Run 'omni-wf-state init' first."
      exit 1
    fi
    ;;

  init)
    ensure_dirs
    if [ -f "$STATE_FILE" ]; then
      echo "State already exists at $STATE_FILE"
      exit 0
    fi
    branch=$(git branch --show-current 2>/dev/null || echo "unknown")
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    cat > "$STATE_FILE" <<EOF
# Omni Workflow State

## Current Phase: IDLE
## Current Stage: none
## Branch: $branch
## Started At: $now
## Last Updated: $now

## Completed Phases
- [ ] THINK
- [ ] PLAN
- [ ] ISSUES
- [ ] BUILD
- [ ] TEST
- [ ] SHIP

## Pending Decisions
None

## PRDs
None

## GitHub Issues
None

## Notes
EOF
    echo "Initialized $STATE_FILE"
    ;;

  phase)
    [ -z "${2:-}" ] && { echo "Usage: omni-wf-state phase <PHASE>"; exit 1; }
    if [ ! -f "$STATE_FILE" ]; then
      echo "No state found. Run 'omni-wf-state init' first."
      exit 1
    fi
    sed -i "s/^## Current Phase:.*/## Current Phase: $2/" "$STATE_FILE"
    sed -i "s/^## Last Updated:.*/## Last Updated: $(date -u +%Y-%m-%dT%H:%M:%SZ)/" "$STATE_FILE"
    echo "Phase set to: $2"
    ;;

  stage)
    [ -z "${2:-}" ] && { echo "Usage: omni-wf-state stage <STAGE>"; exit 1; }
    if [ ! -f "$STATE_FILE" ]; then
      echo "No state found. Run 'omni-wf-state init' first."
      exit 1
    fi
    sed -i "s/^## Current Stage:.*/## Current Stage: $2/" "$STATE_FILE"
    sed -i "s/^## Last Updated:.*/## Last Updated: $(date -u +%Y-%m-%dT%H:%M:%SZ)/" "$STATE_FILE"
    echo "Stage set to: $2"
    ;;

  *)
    echo "Usage: omni-wf-state [get|init|phase <PHASE>|stage <STAGE>]"
    exit 1
    ;;
esac
