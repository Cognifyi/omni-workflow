{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./mcp-server/dist",
    "rootDir": "."
  },
  "include": ["mcp-server/src/**/*"],
  "exclude": ["node_modules", "mcp-server/dist"]
}
